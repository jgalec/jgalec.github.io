---
import { getLocale, paths, type Page } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const alternateLocale = locale === 'es' ? 'en' : 'es';
const labels = locale === 'en'
	? {
		ariaLabel: 'Main navigation',
		home: 'Home',
		projects: 'Projects',
		experience: 'Experience',
		contact: 'Contact',
		github: 'Juan Galeano on GitHub',
		linkedin: 'Juan Galeano on LinkedIn',
		email: 'Email Juan Galeano',
		language: 'View in Spanish',
	}
	: {
		ariaLabel: 'Navegación principal',
		home: 'Inicio',
		projects: 'Proyectos',
		experience: 'Experiencia',
		contact: 'Contacto',
		github: 'GitHub de Juan Galeano',
		linkedin: 'LinkedIn de Juan Galeano',
		email: 'Enviar correo a Juan Galeano',
		language: 'View in English',
	};
const normalizePath = (path: string) => (path === '/' ? path : path.replace(/\/$/, ''));
const currentPath = normalizePath(Astro.url.pathname);
const currentPage = (Object.entries(paths[locale]).find(([, path]) => normalizePath(path) === currentPath)?.[0] ?? 'experience') as Page;
const spanishCasePrefix = '/experiencia/';
const englishCasePrefix = '/en/experience/';
const alternatePath = locale === 'es' && currentPath.startsWith(spanishCasePrefix)
	? `${englishCasePrefix}${currentPath.slice(spanishCasePrefix.length)}`
	: locale === 'en' && currentPath.startsWith(englishCasePrefix)
		? `${spanishCasePrefix}${currentPath.slice(englishCasePrefix.length)}`
		: paths[alternateLocale][currentPage];
---

<header>
    <nav
        class="mx-auto flex max-w-3xl flex-col items-stretch gap-3 border-b border-ef-border px-6 py-4 sm:flex-row sm:items-center sm:justify-between sm:py-6"
        aria-label={labels.ariaLabel}
    >
        <div class="grid grid-cols-2 place-items-center gap-x-2 gap-y-1 sm:flex sm:gap-6">
            {
                (Object.keys(paths[locale]) as Page[]).map((page) => (
                    <a
                        href={paths[locale][page]}
                        data-active={currentPage === page ? 'true' : undefined}
                        class="inline-flex min-h-11 items-center text-sm font-medium text-ef-muted no-underline transition-colors hover:text-ef-green sm:min-h-0 data-[active=true]:font-bold data-[active=true]:text-ef-fg"
                    >
                        {labels[page]}
                    </a>
                ))
            }
        </div>
        <div class="flex items-center justify-center gap-1 sm:gap-3">
            <a
                class="flex size-11 items-center justify-center text-xs font-bold text-ef-muted no-underline transition-colors hover:text-ef-green sm:size-8"
                href={alternatePath}
                aria-label={labels.language}
            >
                {alternateLocale.toUpperCase()}
            </a>
            <a
                class="flex size-11 items-center justify-center text-xl text-ef-muted no-underline transition-colors hover:text-ef-green sm:size-8"
                href="https://github.com/jgalec"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={labels.github}
            >
                <i class="fa-brands fa-github" aria-hidden="true"></i>
            </a>
            <a
                class="flex size-11 items-center justify-center text-xl text-ef-muted no-underline transition-colors hover:text-ef-green sm:size-8"
                href="https://www.linkedin.com/in/jgaleanoc/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={labels.linkedin}
            >
                <i class="fa-brands fa-linkedin" aria-hidden="true"></i>
            </a>
            <a
                class="flex size-11 items-center justify-center text-xl text-ef-muted no-underline transition-colors hover:text-ef-green sm:size-8"
                href="mailto:juan@jgalec.dev"
                aria-label={labels.email}
            >
                <i class="fa-solid fa-envelope" aria-hidden="true"></i>
            </a>
        </div>
    </nav>
</header>
