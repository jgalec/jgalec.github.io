---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav aria-label="Navegación principal">
		<div class="links">
			<HeaderLink href="/">Inicio</HeaderLink>
			<HeaderLink href="/proyectos">Proyectos</HeaderLink>
			<HeaderLink href="/experiencia-aplicada">Experiencia aplicada</HeaderLink>
			<HeaderLink href="/contacto">Contacto</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		border-bottom: 1px solid var(--ef-border);
		background: var(--ef-bg);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.5rem;
		width: 100%;
		max-width: 48rem;
		margin: 0 auto;
		padding: 1rem 1.5rem;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 3rem;
		margin: 0 auto;
	}
</style>
