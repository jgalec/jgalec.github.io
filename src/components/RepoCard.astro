---
import ArrowLink from './ArrowLink.astro';

interface Props {
	name: string;
	description: string;
	htmlUrl: string;
	language?: string;
	stars?: number;
	badge?: string;
}

const { name, description, htmlUrl, language, stars = 0, badge } = Astro.props;
const linkLabel = Astro.currentLocale === 'en' ? 'Explore' : 'Explorar';
---

<a href={htmlUrl} target="_blank" rel="noopener noreferrer" class="group block overflow-hidden rounded-lg border border-ef-border bg-ef-bg-card no-underline shadow-sm">
	<div class="flex flex-col gap-3 p-4">
		<div class="flex items-start justify-between gap-2">
			<h3 class="text-sm font-bold text-ef-fg">{name}</h3>
			{badge && <span class="shrink-0 rounded-full bg-ef-bg-dim px-2 py-0.5 text-[10px] font-medium tracking-wider text-ef-muted uppercase">{badge}</span>}
		</div>
		<p class="line-clamp-2 text-xs text-ef-fg opacity-60">{description}</p>
		<div class="flex flex-wrap gap-1.5">
			{language && <span class="rounded-full border border-ef-border px-2 py-0.5 text-[10px] text-ef-fg opacity-50">{language}</span>}
			{stars > 0 && <span class="rounded-full border border-ef-border px-2 py-0.5 text-[10px] text-ef-fg opacity-50">&starf; {stars}</span>}
		</div>
		<ArrowLink label={linkLabel} />
	</div>
</a>
