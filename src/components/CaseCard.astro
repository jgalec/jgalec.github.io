---
import ArrowLink from './ArrowLink.astro';

interface Props {
	title: string;
	description: string;
	href: string;
	technologies: string[];
}

const { title, description, href, technologies } = Astro.props;
---

<a href={href} class="group block overflow-hidden rounded-lg border border-ef-border bg-ef-bg-card no-underline shadow-sm">
	<div class="flex flex-col gap-3 p-4">
		<h3 class="text-sm font-bold text-ef-fg">{title}</h3>
		<p class="line-clamp-2 text-xs text-ef-fg opacity-60">{description}</p>
		<div class="flex flex-wrap gap-1.5">
			{technologies.map((technology) => <span class="rounded-full border border-ef-border px-2 py-0.5 text-[10px] text-ef-fg opacity-50">{technology}</span>)}
		</div>
		<ArrowLink label="Ver caso" />
	</div>
</a>
