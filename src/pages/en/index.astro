---
import Layout from '../../layouts/Layout.astro';
---

<Layout
	title="Juan Galeano"
	description="Backend developer and AI agent automation specialist."
>
	<section class="flex flex-1 flex-col items-start justify-center">
		<pre
			class="mb-6 animate-color-cycle font-mono text-[clamp(1.25rem,4vw,2rem)] font-bold leading-none motion-reduce:animate-none"
			aria-hidden="true">jgalec@dev:~$</pre>
		<p class="mb-4 text-xs font-medium tracking-[0.04em] text-ef-fg opacity-80 uppercase">
			Backend · Automation · AI Agents
		</p>
		<h1 class="w-full max-w-none text-[clamp(2rem,4vw,2.5rem)]">
			I build systems that keep operations moving.
		</h1>
		<p class="mt-6 max-w-2xl text-ef-fg opacity-80">
			I am Juan Galeano. I work in backend development and AI agent automation. I build maintainable services, integrations, and workflows that solve real operational processes.
		</p>
		<div class="mt-8 flex flex-wrap gap-x-6 gap-y-4">
			<a
				class="group inline-flex min-h-11 items-center rounded-lg bg-ef-bg-card px-3.5 py-2.5 text-sm font-bold text-ef-fg no-underline transition-colors hover:bg-ef-bg-hover hover:text-ef-fg"
				href="/en/projects"
			>
				View personal projects <span
					class="inline-block transition-transform group-hover:translate-x-1 motion-reduce:transform-none"
					aria-hidden="true">→</span
				>
			</a>
			<a
				class="group inline-flex min-h-11 items-center rounded-lg border border-ef-border px-3.5 py-2.5 text-sm font-bold text-ef-fg no-underline transition-colors hover:border-ef-green hover:text-ef-green"
				href="/en/experience"
			>
				View experience <span
					class="inline-block transition-transform group-hover:translate-x-1 motion-reduce:transform-none"
					aria-hidden="true">→</span
				>
			</a>
		</div>
	</section>
</Layout>
